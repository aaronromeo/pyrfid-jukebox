# Copy to /etc/environment and/or /home/pi/.soundsprout/conf (dotenv loaded by soundsprout-server).
# See README step 16.
# Required: Bluetooth speaker MAC used by `btconnect` and `templategen`.
PJ_BLUETOOTH_DEVICE=XX:XX:XX:XX:XX:XX
# Optional: branch watched by system/scripts/gitpull.sh (defaults to main).
PJ_DEFAULT_BRANCH=main
